# =============================================================================
# TkxHi — variáveis de ambiente
#
# Este é o MODELO (vai para o git, sem nenhum segredo). `npm run setup` copia
# para `.env`, gera os segredos e configura o admin master.
#
# O `.env` NUNCA vai para o git (.gitignore: .env*). Não mande por e-mail,
# WhatsApp ou print. Em produção, cadastre cada variável no painel da Vercel
# como "Sensitive" (Settings → Environment Variables), com valores DIFERENTES
# para Production e Preview.
#
# Passo a passo:
#   1. npm run setup      → cria o .env, gera APP_SECRET, DATA_ENCRYPTION_KEY e o master
#   2. preencha no .env as variáveis marcadas [manual]
#   3. npm run db:migrate → cria as tabelas
#
# Guia completo: docs/cursos.md
# =============================================================================

# ---- Banco [manual] ---------------------------------------------------------
# Postgres (Supabase: string do pooler, porta 6543; Vercel/Neon: POSTGRES_URL).
# Use um usuário do banco só para o app, sem permissão de superusuário.
DATABASE_URL=

# ---- Mercado Pago [manual] --------------------------------------------------
# Suas integrações → sua aplicação → Credenciais. TEST-... em teste,
# APP_USR-... em produção.
MP_ACCESS_TOKEN=
# Suas integrações → Webhooks → "Assinatura secreta" (evento: Pagamentos).
MP_WEBHOOK_SECRET=

# ---- Segredos gerados [npm run setup] ---------------------------------------
# Assina os links de reembolso (chaves derivadas por HKDF). Trocar invalida
# links enviados nas últimas 72 h — use "npm run setup -- --rotate-app-secret",
# que guarda o antigo em APP_SECRET_PREVIOUS durante a transição.
APP_SECRET=
APP_SECRET_PREVIOUS=
# Cifra CPF e segredos 2FA no banco (AES-256-GCM). NUNCA troque sem recifrar os
# dados: perder esta chave é perder os CPFs. Guarde uma cópia num cofre de
# senhas (1Password, Bitwarden).
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_PREVIOUS=

# ---- Admin master [npm run setup] -------------------------------------------
# Quem cria os demais admins. A senha nunca fica aqui: só o hash scrypt.
# Refazer: npm run setup -- --master (derruba as sessões abertas do master).
ADMIN_MASTER_USERNAME=
ADMIN_MASTER_PASSWORD_HASH=
ADMIN_MASTER_TOTP_SECRET=

# ---- E-mail [manual; obrigatório em produção] -------------------------------
# resend.com → API Keys (permissão "Sending access" apenas). Sem chave, fora de
# produção, os e-mails são impressos no console.
RESEND_API_KEY=
# Remetente num domínio verificado no Resend, ex.: TkxHi <cursos@tkxhi.com>
EMAIL_FROM=
# Quem recebe avisos de reembolso em análise e de chargeback (vírgula separa).
ADMIN_NOTIFY_EMAIL=

# ---- URL pública [opcional] -------------------------------------------------
# Links de e-mail, QR code e retorno do pagamento. Na Vercel, deixe vazio
# (usa o domínio do deploy).
APP_URL=http://localhost:3000

# ---- Indexação [opcional] ---------------------------------------------------
# true só no deploy do domínio oficial (ver src/lib/env.ts).
NEXT_PUBLIC_ALLOW_INDEXING=
